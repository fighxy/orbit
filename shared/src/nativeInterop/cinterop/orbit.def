# Kotlin/Native binding of the C ABI in crates/orbit-ffi/include/orbit.h.
# The static library path is supplied per target by shared/build.gradle.kts.
headers = orbit.h
headerFilter = orbit.h
package = com.orbit.sdk.ffi
staticLibraries = liborbit_ffi.a
linkerOpts = -framework Security -framework CoreFoundation
